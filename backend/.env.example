# Server Port
PORT=5000

# PostgreSQL Connection String
# Format: postgresql://username:password@hostname:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_diet_planner

# Optional Individual PG Parameters
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ai_diet_planner
PGPORT=5432

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret for Staff / Admin Authentication
JWT_SECRET=pulsefit_super_secret_jwt_key_replace_in_production_2026

# Admin Credentials
ADMIN_EMAIL=admin@pulsefit.com
ADMIN_PASSWORD=pulsefit_admin_2026
# Optional Pre-Hashed Bcrypt Password (overrides ADMIN_PASSWORD if set):
# ADMIN_PASSWORD_HASH=$2a$10$...
